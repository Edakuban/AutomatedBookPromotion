# Copy to .env; never put real credentials in this example.
# Existing process environment variables override this file.

APP_HOST=127.0.0.1
APP_PORT=8000
# Relative to this env file. Keep private files inside data/.
APP_DATA_DIR=data
APP_MAX_UPLOAD_MB=25

# Needed from the Supabase integration step onwards.
# Keep false until SQL setup and verification in step 3.2 are complete.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Needed from the AI analysis step onwards.
OPENWEBUI_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=
OPENWEBUI_TIMEOUT_SECONDS=120
# Additional attempts for explicit temporary errors; read timeouts are not retried.
OPENWEBUI_MAX_RETRIES=2

# Local Reel rendering. Workflow paths are relative to this ENV file.
COMFYUI_URL=http://127.0.0.1:8188
REEL_IMAGE_WORKFLOW=workflows/reel-image.json
REEL_REFERENCE_WORKFLOW=workflows/reel-reference.json
REEL_VIDEO_WORKFLOW=workflows/reel-video.json
REEL_DEFAULT_DURATION_SECONDS=10
REEL_MAX_AUDIO_MB=250
REEL_MAX_VIDEO_MB=45

# Reel storage. Supabase remains the default. For Cloudflare R2, use the S3
# endpoint shown in the bucket settings; credentials stay here, never in the UI.
REEL_STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=book-promotion-reels
R2_ENDPOINT=
# Optional custom domain, e.g. https://media.example.com. Without it n8n
# creates a short-lived signed R2 URL just before publishing.
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=86400

# Analysis policy is captured per run; changes create a new run when started.
ANALYSIS_CHUNK_CHARS=12000
ANALYSIS_MIN_SCORE=4
ANALYSIS_MAX_QUOTES_PER_CHAPTER=12
ANALYSIS_MAX_CALLS=1000

# OpenAI, Telegram and Instagram credentials belong in n8n.

# Optional API access for n8n workflow/execution diagnostics.
N8N_URL=
N8N_API_KEY=
