# Copy to .env; never put real credentials in this example.
# Existing process environment variables override this file.

APP_HOST=127.0.0.1
APP_PORT=8000
# Relative to this env file. Keep private files inside data/.
APP_DATA_DIR=data
APP_MAX_UPLOAD_MB=25

# Needed from the Supabase integration step onwards.
# Keep false until SQL setup and verification in step 3.2 are complete.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Needed from the AI analysis step onwards.
OPENWEBUI_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=
OPENWEBUI_TIMEOUT_SECONDS=120
# Additional attempts for explicit temporary errors; read timeouts are not retried.
OPENWEBUI_MAX_RETRIES=2

# Analysis policy is captured per run; changes create a new run when started.
ANALYSIS_CHUNK_CHARS=12000
ANALYSIS_MIN_SCORE=4
ANALYSIS_MAX_QUOTES_PER_CHAPTER=12
ANALYSIS_MAX_CALLS=1000

# OpenAI, Telegram and Instagram credentials belong in n8n.

# Optional API access for n8n workflow/execution diagnostics.
N8N_URL=
N8N_API_KEY=
