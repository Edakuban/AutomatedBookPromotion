{
  "1": {
    "inputs": {
      "prompt": "{{ prompt }}",
      "max_length": 3200,
      "sampling_mode": "on",
      "sampling_mode.temperature": 0.2,
      "sampling_mode.top_k": 40,
      "sampling_mode.top_p": 0.9,
      "sampling_mode.min_p": 0.05,
      "sampling_mode.repetition_penalty": 1.05,
      "sampling_mode.seed": 0,
      "sampling_mode.presence_penalty": 0,
      "thinking": false,
      "use_default_template": true,
      "clip": ["2", 0]
    },
    "class_type": "TextGenerate",
    "_meta": {"title": "Structured text with local Qwen"}
  },
  "2": {
    "inputs": {
      "clip_name": "qwen3.5_4b_bf16.safetensors",
      "type": "stable_diffusion",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load local Qwen"}
  },
  "3": {
    "inputs": {"source": ["1", 0]},
    "class_type": "PreviewAny",
    "_meta": {"title": "Structured text result"}
  }
}
